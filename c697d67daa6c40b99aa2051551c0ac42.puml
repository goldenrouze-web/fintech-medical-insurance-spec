@startuml DMS_Policy_Issuance
title Выдача ДМС-полиса — Activity Diagram

skinparam ConditionEndStyle hline
skinparam ActivityShape roundbox
skinparam ActivityDiamondBackgroundColor #FFF4C2
skinparam BackgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"

|#E3F2FD|Клиент|
|#FFF3E0|Агент / Frontend|
|#E8F5E9|Система ДМС|
|#FCE4EC|Внешние системы|

|Клиент|
start
:Заполнение анкеты
(ФИО, паспорт, СНИЛС, программа);

|Агент / Frontend|
:Регистрация заявки,
первичная валидация полей;

if (Данные корректны?) then (нет)
  repeat
    |Клиент|
    :Исправление данных;
    |Агент / Frontend|
    :Повторная валидация;
  repeat while (Остались ошибки?) is (да) not (нет)
else (да)
endif

|Система ДМС|
:Проверка идемпотентности
(дубль заявки?);

if (Дубликат найден?) then (да)
  :Возврат ссылки на прежнюю заявку;
  stop
else (нет)
endif

fork
  |Внешние системы|
  :KYC + антифрод;
fork again
  |Внешние системы|
  :Медицинская история
  и риск-скор;
fork again
  |Система ДМС|
  :Расчёт тарифа;
end fork

|Система ДМС|
if (Есть недоступные сервисы?) then (да)
  repeat
    :Повтор запроса
    с экспоненциальной задержкой;
  repeat while (< 3 попыток
  и всё ещё fail?) is (да) not (нет)

  if (Сервис так и не ответил?) then (да)
    :Заявка в ручную обработку,
    алерт DevOps;
    stop
  else (нет)
  endif
else (нет)
endif

if (Клиент прошёл проверки?) then (нет)
  :Мотивированный отказ,
  уведомление клиенту;
  stop
else (да)
endif

:Формирование черновика полиса
(PDF-превью с условиями);

|Клиент|
if (Согласен с условиями?) then (нет)
  :Заявка закрывается
  со статусом "Отменена клиентом";
  stop
else (да)
  :Электронная подпись
  (СМС-код / ЭЦП);
endif

|Система ДМС|
if (Подпись валидна?) then (нет)
  repeat
    |Клиент|
    :Повторный ввод кода;
  repeat while (Подпись невалидна
  и попыток < 3?) is (да) not (нет)

  if (Лимит исчерпан?) then (да)
    :Блокировка заявки;
    stop
  else (нет)
  endif
else (да)
endif

|Внешние системы|
repeat
  :Платёж в платёжном шлюзе;
  if (Успех?) then (да)
  else (нет)
    |Клиент|
    :Ошибка оплаты,
    предложить другой способ;
  endif
repeat while (Неуспех и попыток < 3?) is (да) not (нет)

|Система ДМС|
if (Оплата прошла?) then (нет)
  :Отмена, статус "Не оплачено";
  stop
else (да)
endif

repeat
  :Регистрация полиса
  в реестре (ЕГИС ДМС);
repeat while (Регистрация успешна?) is (нет — повтор) not (да)

:Генерация финального PDF
с ЭЦП страховщика;

fork
  :E-mail клиенту;
fork again
  :Публикация в личном кабинете;
fork again
  :Push / SMS-уведомление;
end fork

|Клиент|
:Получение полиса;

|Система ДМС|
:Закрытие заявки ("Исполнена");
stop

@enduml
