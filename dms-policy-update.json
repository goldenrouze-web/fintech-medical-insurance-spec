{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "dms-policy-update",
  "title": "Обновление полиса",
  "description": "Тело PUT /dms/policies/{id}. Полная замена, partial update не поддерживаем.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_type",
    "policyholder_id",
    "coverage_program_id",
    "insured_persons",
    "valid_from",
    "valid_to"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["draft", "pending", "active", "expired", "cancelled"],
      "description": "Новый статус. Сервер проверяет допустимость перехода, невалидный переход = 409."
    },
    "program_type": {
      "type": "string",
      "enum": ["individual", "family", "corporate"]
    },
    "policyholder_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "coverage_program_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "insured_persons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "insured-person.json" }
    },
    "valid_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "valid_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
