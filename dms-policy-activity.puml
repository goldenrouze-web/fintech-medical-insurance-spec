@startuml DMS_Policy_Issuance
title Выдача ДМС-полиса — Activity Diagram

skinparam ConditionEndStyle hline
skinparam ActivityShape roundbox
skinparam ActivityDiamondBackgroundColor #FFF4C2
skinparam BackgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"

|#E3F2FD|Клиент|
|#FFF3E0|Frontend|
|#E8F5E9|Система ДМС|
|#FCE4EC|Внешние системы|

|Клиент|
start
:Заполнение анкеты;

|Frontend|
:Валидация данных;

if (Данные корректны?) then (нет)
  repeat
    |Клиент|
    :Исправление ошибок;
    |Frontend|
    :Повторная валидация;
  repeat while (Есть ошибки?) is (да) not (нет)
else (да)
endif

|Система ДМС|
:Создание заявки;

:Проверка идемпотентности;

if (Дубликат?) then (да)
  :Возврат существующей заявки;
  stop
else (нет)
endif

fork
  |Внешние системы|
  :Андеррайтинг;
fork again
  |Внешние системы|
  :KYC / антифрод;
fork again
  |Система ДМС|
  :Расчет стоимости;
end fork

|Система ДМС|
if (Ошибка интеграции?) then (да)
  repeat
    :Retry запросов;
  repeat while (Попыток < 3?) is (да) not (нет)

  if (Ошибка сохраняется?) then (да)
    :Ручная обработка;
    stop
  else (нет)
  endif
else (нет)
endif

if (Андеррайтинг ок?) then (нет)
  :Отказ;
  stop
else (да)
endif

if (Расчет успешен?) then (нет)
  :Ошибка расчета;
  stop
else (да)
endif

:Формирование предложения;

|Клиент|
if (Согласен?) then (нет)
  :Отмена;
  stop
else (да)
  :Подпись;
endif

|Система ДМС|
if (Подпись валидна?) then (нет)
  repeat
    |Клиент|
    :Повтор подписи;
  repeat while (Попыток < 3?) is (да) not (нет)

  if (Лимит?) then (да)
    :Блокировка;
    stop
  else (нет)
  endif
else (да)
endif

|Внешние системы|
repeat
  :Платеж;
  if (Успешно?) then (да)
  else (нет)
    |Клиент|
    :Ошибка оплаты;
  endif
repeat while (Неуспех?) is (да) not (нет)

|Система ДМС|
if (Оплата прошла?) then (нет)
  :Не оплачено;
  stop
else (да)
endif

repeat
  :Регистрация полиса;
repeat while (Ошибка?) is (да) not (нет)

:Генерация PDF;

fork
  :Email;
fork again
  :ЛК;
fork again
  :SMS;
end fork

|Клиент|
:Получение полиса;

|Система ДМС|
:Закрытие заявки;
stop

@enduml
