@startuml IssueDMS_Policy
skinparam backgroundColor #FAFAFA
skinparam activity {
  BackgroundColor #E1F5FE
  BorderColor #0277BD
  FontSize 11
}
skinparam decision {
  BackgroundColor #FFF3E0
  BorderColor #F57C00
}
title Процесс выдачи полиса ДМС

|Клиент|
start
:Получить заявку на ДМС;
:Проверить полноту данных;

if (Данные полные?) then (да)
  |Система|
  fork
    |Сервис идентификации|
    :Проверить/создать профиль клиента;
    if (Клиент найден/создан?) then (да)
    else (ошибка)
      :Отправить ошибку создания профиля;
      kill
    endif
  fork again
    |Сервис платежей|
    :Рассчитать премию ДМС;
  end fork
  :Получить результат расчета;
  
  if (Премия рассчитана?) then (да)
    repeat
      :Инициировать оплату;
      |Платежный шлюз|
      :Обработать платеж;
      
      if (Платеж успешен?) then (да)
        |Сервис полисов|
        :Генерировать полис ДМС;
        if (Полис создан?) then (да)
          :Отправить полис клиенту (email/PDF);
          :Зафиксировать в реестре полисов;
        else (ошибка генерации)
          :Инициировать возврат средств;
          :Отправить уведомление об ошибке;
        endif
        break
      else (платеж отклонен)
        :Отправить уведомку о неудаче;
      endif
    repeat while (Повторить оплату?) is (да -> нет)
    :Завершить сессию;
  else (ошибка расчета)
    :Отправить ошибку расчета премии;
    kill
  endif
else (данные неполные)
  :Запросить недостающие данные;
  :Ожидать дополнения;
  stop
endif

|Администратор|
:Обработать критические ошибки\n(ручной режим);

stop
@enduml
