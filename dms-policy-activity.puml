@startuml DMS_Policy_Issuance
title Выдача ДМС-полиса — Activity Diagram

skinparam ConditionEndStyle hline
skinparam ActivityShape roundbox
skinparam ActivityDiamondBackgroundColor #FFF4C2
skinparam BackgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"

|#E3F2FD|Клиент|
|#FFF3E0|Frontend|
|#E8F5E9|Система ДМС|
|#FCE4EC|Внешние системы|

|Клиент|
start
:Заполнение анкеты
(ФИО, паспорт, СНИЛС,
контакты, программа);

|Frontend|
:Первичная валидация
(маски, обязательность);

if (Данные корректны?) then (нет)
  repeat
    |Клиент|
    :Исправление ошибок;
    |Frontend|
    :Повторная валидация;
  repeat while (Есть ошибки?) is (да) not (нет)
else (да)
endif

|Frontend|
:POST /v1/applications
+ заголовок Idempotency-Key (UUID);

|Система ДМС|
partition "API-слой" {
  :Проверка Idempotency-Key
  (Redis, TTL = 24ч);
  if (Ключ уже видели?) then (да)
    :Возврат сохранённого ответа
    (application_id, status);
    detach
  else (нет)
  endif

  :BEGIN TX;
  :INSERT applications (status = NEW)
  + audit_log
  + outbox-запись application.created;
  :COMMIT TX (~50 мс);

  :HTTP 202 Accepted
  + application_id
  + Location: /v1/applications/{id}/status;
}

|Frontend|
:Поллинг GET /v1/applications/{id}/status
(2с → 5с → 10с, jitter ±20%)
либо SSE-подписка;

|Система ДМС|
partition "Outbox relay" {
  :Публикация application.created
  в Kafka topic dms.applications;
}

partition "Worker: оркестрация (saga)" {
  :status = IN_PROGRESS
  (короткая TX);

  fork
    |Внешние системы|
    :Андеррайтинг
    (мед. БД, circuit breaker,
    timeout 8с);
  fork again
    |Внешние системы|
    :KYC / антифрод
    (circuit breaker, timeout 8с);
  fork again
    |Система ДМС|
    :Расчёт стоимости
    (внутренний сервис);
  end fork

  |Система ДМС|
  if (Все сервисы ответили?) then (нет)
    :В очередь dms.retry
    next_attempt_at = now + 30с
    (backoff 30с → 2м → 10м → 1ч);
    if (Попытки исчерпаны?) then (да)
      :status = MANUAL_REVIEW,
      задача оператору + alert DevOps;
      end
    else (нет)
      :Ждём next_attempt_at;
      detach
    endif
  else (да)
  endif

  if (Андеррайтинг APPROVED
  и KYC PASSED?) then (нет)
    :status = REJECTED + reason_code,
    событие application.rejected;
    end
  else (да)
  endif

  if (Нужен ручной разбор скоринга?) then (да)
    :status = PENDING_MANUAL_REVIEW,
    задача оператору в АРМ;
    note right
      Поток обрывается.
      Возобновится по событию
      manual_review.completed —
      длительность не ограничиваем
      (час, сутки — не важно).
    end note
    end
  else (нет)
  endif

  :Расчёт final_premium
  (база + надбавки − скидки);
  :status = PRICED
  + событие application.priced;
}

|Frontend|
:Поллинг видит status = PRICED
→ экран оплаты;

|Клиент|
:Подтверждение оплаты
(переход в платёжный шлюз);

|Внешние системы|
:Платёжный шлюз
(3DS, списание);

|Система ДМС|
partition "Платёжный callback" {
  :POST /v1/payments/callback
  (HMAC-SHA256, идемпотентно
  по payment_id);
  if (Подпись валидна?) then (нет)
    :HTTP 401, инцидент в журнал;
    end
  else (да)
  endif
  :status = PAID
  + событие payment.confirmed;
}

partition "Worker: оформление полиса" {
  :Генерация PDF полиса
  (шаблон + данные заявки);
  :PUT в S3
  (s3://dms-policies/{yyyy}/{mm}/{policy_number}.pdf)
  + pdf_uri в applications;

  :POST в ЕГИС ДМС
  (идемпотентно по policy_number);
  if (ЕГИС ответил?) then (нет)
    :status = POLICY_PENDING_REGISTRATION,
    фоновый дожим;
    note right
      Полис юридически выдан,
      клиента не блокируем.
      Регистрация догонит асинхронно.
    end note
  else (да)
    :status = ACTIVE;
  endif

  :Публикация policy.issued
  в Kafka topic dms.policies;
}

|Внешние системы|
partition "Notification service (own retries + DLQ)" {
  fork
    :E-mail (SendGrid);
  fork again
    :SMS (шлюз);
  fork again
    :Push (FCM);
  end fork
  note right
    Каналы независимы.
    Падение одного из них
    не валит остальные —
    у каждого свой ретрай и DLQ.
  end note
}

|Frontend|
:Видит status = ACTIVE
→ кнопка «скачать полис»
(GET /v1/applications/{id}/policy.pdf);

|Система ДМС|
:Проверка прав доступа,
streaming PDF из S3 через бэк
(signed URL, TTL 5 мин,
наружу не отдаём);

|Клиент|
:Получение полиса в PDF;
stop

@enduml
