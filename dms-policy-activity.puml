@startuml DMS_Policy_Issuance
title Выдача ДМС-полиса — Activity Diagram

skinparam ConditionEndStyle hline
skinparam ActivityShape roundbox
skinparam ActivityDiamondBackgroundColor #FFF4C2
skinparam BackgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"

|#E3F2FD|Клиент|
|#FFF3E0|Frontend|
|#E8F5E9|Система ДМС|
|#FCE4EC|Внешние системы|

|Клиент|
start
:Заполнение анкеты
(ФИО, паспорт, СНИЛС,
контакты, программа);

|Frontend|
:Валидация данных;

if (Данные корректны?) then (нет)
  repeat
    |Клиент|
    :Исправление ошибок;
    |Frontend|
    :Повторная валидация;
  repeat while (Есть ошибки?) is (да) not (нет)
else (да)
endif

|Система ДМС|
:Создание заявки
(ID, статус NEW);

:Проверка идемпотентности
(дубль за 30 минут?);

if (Дубликат?) then (да)
  :Возврат ссылки на существующую заявку,
  лог события "duplicate";
  end
else (нет)
endif

fork
  |Внешние системы|
  :Андеррайтинг
  (риск-скор);
fork again
  |Внешние системы|
  :KYC / антифрод;
fork again
  |Система ДМС|
  :Расчёт стоимости;
end fork

|Система ДМС|
if (Все сервисы ответили?) then (нет)
  repeat
    :Retry с экспоненциальной
    задержкой 1-2-4с;
  repeat while (Попыток < 3?) is (да) not (нет)

  if (Сервис всё ещё недоступен?) then (да)
    :Перевод заявки в MANUAL_REVIEW,
    задача оператору, alert DevOps;
    end
  else (нет)
  endif
else (да)
endif

if (Андеррайтинг + KYC прошли?) then (нет)
  :Мотивированный отказ,
  статус DECLINED, e-mail клиенту;
  end
else (да)
endif

if (Расчёт успешен?) then (нет)
  :Статус CALCULATION_FAILED,
  инцидент DevOps, уведомление клиенту;
  end
else (да)
endif

:Формирование предложения
(PDF-черновик с условиями);

|Клиент|
if (Согласен с условиями?) then (нет)
  |Система ДМС|
  :Закрытие заявки CANCELLED_BY_CLIENT,
  фиксация причины;
  end
else (да)
  |Клиент|
  :Электронное подписание
  (СМС-код / ЭЦП);
endif

|Система ДМС|
if (Подпись валидна?) then (нет)
  repeat
    |Клиент|
    :Повторный ввод кода;
    |Система ДМС|
    :Проверка подписи;
  repeat while (Подпись невалидна
  и попыток < 3?) is (да) not (нет)

  if (Лимит исчерпан?) then (да)
    :Блокировка BLOCKED_SECURITY,
    инцидент SecOps;
    end
  else (нет)
  endif
else (да)
endif

|Внешние системы|
repeat
  :Платёж в шлюзе
  (создание сессии, webhook);
  if (Успешно?) then (да)
  else (нет)
    |Клиент|
    :Уведомление об ошибке оплаты,
    выбор другого способа;
  endif
repeat while (Неуспех и попыток < 3?) is (да) not (нет)

|Система ДМС|
if (Оплата прошла?) then (нет)
  :Статус PAYMENT_FAILED,
  освобождение тарифов, e-mail клиенту;
  end
else (да)
endif

repeat
  :Регистрация полиса в реестре
  (ЕГИС ДМС, серия + номер);
repeat while (Регистрация успешна?) is (нет — повтор) not (да)

:Финальный PDF с ЭЦП страховщика;

fork
  :E-mail клиенту;
fork again
  :Публикация в ЛК;
fork again
  :Push / SMS-уведомление;
end fork

|Клиент|
:Получение полиса;

|Система ДМС|
:Закрытие заявки
(статус CLOSED, метрики SLA);
stop

@enduml
