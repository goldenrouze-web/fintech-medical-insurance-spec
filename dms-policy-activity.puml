@startuml DMS_Policy_Issuance
title Выдача ДМС-полиса. Activity Diagram

skinparam ConditionEndStyle hline
skinparam ActivityShape roundbox
skinparam ActivityDiamondBackgroundColor #FFF4C2
skinparam BackgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"

|#E3F2FD|Клиент|
|#FFF3E0|Frontend|
|#E8F5E9|Система ДМС|
|#FCE4EC|Внешние системы|

|Клиент|
start
:Заполнение анкеты
(ФИО, паспорт, СНИЛС,
контакты, программа);

|Frontend|
:Локальная валидация полей;

if (Данные корректны?) then (нет)
  repeat
    |Клиент|
    :Исправление ошибок;
    |Frontend|
    :Повторная валидация;
  repeat while (Есть ошибки?) is (да) not (нет)
else (да)
endif

|Frontend|
:POST /v1/applications,
заголовок Idempotency-Key;

|Система ДМС|
:Проверка ключа в Redis,
TTL 24 часа;
if (Ключ повторный?) then (да)
  :Возврат сохранённого ответа;
  detach
else (нет)
endif

:Создание заявки в одной транзакции:
INSERT applications (status = NEW),
audit_log, outbox-запись application.created;

:HTTP 202 Accepted, application_id,
Location на статус-эндпоинт;

|Frontend|
:Поллинг GET /v1/applications/{id}/status,
интервалы 2с, 5с, 10с
плюс случайное смещение до 20%;

|Система ДМС|
:Воркер читает application.created из Kafka,
status = IN_PROGRESS,
шаг записан в saga_state;

repeat
  fork
    |Внешние системы|
    :Андеррайтинг
    (мед.БД, circuit breaker, 8с);
  fork again
    |Внешние системы|
    :KYC и антифрод
    (circuit breaker, 8с);
  fork again
    |Система ДМС|
    :Расчёт стоимости;
  end fork

  |Система ДМС|
  if (Все сервисы ответили?) then (да)
    break
  else (нет)
    if (Попыток < 4 (30с, 2м, 10м, 1ч)?) then (да)
      :Запись next_attempt_at и retry_count.
      Планировщик возобновит обработку;
    else (нет)
      :status = MANUAL_REVIEW,
      задача оператору, alert DevOps;
      :Ожидание операторской резолюции
      (AcceptEventAction);
    endif
  endif
repeat while (повтор вызовов) is (да) not (нет)

|Система ДМС|
if (underwriting = APPROVED
и kyc = PASSED?) then (нет)
  :status = REJECTED + reason_code,
  событие application.rejected;
  stop
else (да)
endif

if (Скоринг помечен как ручной?) then (да)
  :status = PENDING_MANUAL_REVIEW,
  задача оператору в АРМ;
  :Ожидание manual_review.completed
  (AcceptEventAction).
  Откат не нужен:
  внешние вызовы read-only,
  заявка ждёт оператора в БД;
else (нет)
endif

:Расчёт final_premium,
status = PRICED;

|Frontend|
:Видит status = PRICED,
POST /v1/applications/{id}/payment;

|Система ДМС|
:Создание сессии в платёжном шлюзе,
возврат payment_url;

|Frontend|
:Редирект клиента на payment_url;

|Клиент|
:Ввод данных карты, 3DS;

|Внешние системы|
:Платёжный шлюз
проводит списание;

|Система ДМС|
:S2S callback POST /v1/payments/callback,
подпись HMAC-SHA256;
if (Подпись валидна?) then (нет)
  :HTTP 401, инцидент в журнал.
  Заявка остаётся в PRICED.
  По таймауту 30 минут
  status = PAYMENT_EXPIRED;
  stop
else (да)
  :status = PAID,
  событие payment.confirmed;
endif

repeat
  :Воркер генерирует PDF,
  выполняет PUT в S3
  (3 ретрая внутри попытки);
  if (Загрузка успешна?) then (да)
    break
  else (нет)
    :status = POLICY_PDF_PENDING.
    При access denied или другой
    ошибке IAM создаётся задача SRE;
    :Ожидание разрешения SRE
    (AcceptEventAction);
  endif
repeat while (повтор после фикса) is (да) not (нет)

|Система ДМС|
:pdf_uri в applications;

:POST в ЕГИС ДМС,
идемпотентно по policy_number;
if (ЕГИС ответил?) then (да)
  :status = ACTIVE;
else (нет)
  :status = POLICY_PENDING_REGISTRATION,
  фоновый дожим.
  Полис юридически выдан;
endif

:Публикация policy.issued
в Kafka topic dms.policies
(в обоих ветках:
ACTIVE и POLICY_PENDING_REGISTRATION).
Уведомления не зависят
от регистрации в реестре;

|Внешние системы|
:Notification service подписан на событие.
Email, SMS, push рассылаются независимо
со своими ретраями и DLQ;

|Frontend|
if (status = ACTIVE
или POLICY_PENDING_REGISTRATION?) then (да)
  :Кнопка получения полиса активна;
else (нет)
  :Кнопка скрыта,
  показано сообщение
  «полис формируется»;
  detach
endif

|Клиент|
:Запрос на получение полиса;

|Frontend|
:GET /v1/applications/{id}/policy.pdf;

|Система ДМС|
:Проверка прав доступа клиента;
if (Доступ разрешён?) then (нет)
  :HTTP 403,
  фронт показывает ошибку;
  stop
else (да)
endif

:Получение presigned URL,
streaming PDF из S3 через бэк;

|Клиент|
:Получение полиса в PDF;
stop

@enduml
