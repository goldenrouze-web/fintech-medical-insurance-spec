@startuml IssueDMS_Policy_v2
!define RECTANGLE class

skinparam backgroundColor #FAFAFA
skinparam activity {
  BackgroundColor #E1F5FE
  BorderColor #0277BD
  FontSize 10
  FontName Arial
}
skinparam decision {
  BackgroundColor #FFF3E0
  BorderColor #F57C00
  FontSize 10
}
skinparam note {
  BackgroundColor #E8F5E8
  BorderColor #4CAF50
}

title Процесс выдачи полиса ДМС v2.0\n(с полной обработкой ошибок)

|Клиент|
start
:1. Получить заявку ДМС\n(JSON/FORM API);
note right: ФИО, паспорт, email,\nвозраст, регион, опции

|Система|
:2. Валидация данных\n(схема JSON Schema);
if (2.1 Данные полные?) then (✓)
  fork
    |Сервис идентификации|
    :3.1 Проверить профиль\n(по ФИО+паспорт+email);
    if (3.2 Профиль OK?) then (✓)
      :3.3 Вернуть client_id;
    else (✗)
      :3.4 Создать профиль;
      if (3.5 Создан?) then (✓)
        :3.6 Вернуть client_id;
      else (✗ Дубли/ошибка)
        note right: Лог + уведомление\nадминистратору
        kill
      endif
    endif
  fork again
    |Сервис платежей|
    :4.1 Рассчитать премию\n(тарифы + возраст + регион);
    if (4.2 Расчет OK?) then (✓)
      :4.3 Вернуть premium_amount;
    else (✗ Сервис недоступен)
      note right: Circuit Breaker\nRetry 3x → kill
      kill
    endif
  end fork
  
  :5. Сохранить сессию\n(client_id + premium);
  
  repeat
    :6.1 Создать PaymentIntent\n(Stripe/YandexKassa);
    |Платежный шлюз|
    :6.2 Обработать платеж\n(карта/SBP/ApplePay);
    
    if (6.3 Платеж успешен?) then (✓)
      |Сервис полисов|
      :7.1 Генерировать полис PDF\n(шаблон LaTeX/Puppeteer);
      if (7.2 Полис создан?) then (✓)
        :7.3 Сохранить в S3;
        :8.1 Отправить email + SMS;
        if (8.2 Доставка OK?) then (✓)
          :9.1 Зафиксировать в реестре;
          :9.2 Уведомить BI-систему;
        else (✗ bounce)
          note right: Fallback SMS + ретри\nчерез 24ч
        endif
        detach
      else (✗ шаблон/буфер)
        :7.4 Refund платежа;
        note right: Автоматический возврат\n+ уведомление
      endif
      break
    else (✗ declined)
      :6.4 Проверить код ошибки;
      if (6.5 Retryable?) then (✓ 3DS/card error)
        note right: Пауза 5 сек\nRetry counter++
      else (✗ fraud/block)
        :6.6 Блокировка клиента;
        kill
      endif
    endif
  repeat while (6.7 Retry < 3?) is (✓) 
  -> нет;
  
  :10. Завершить сессию;
  
else (2.2 Неполные данные)
  :2.3 Вернуть список ошибок;
  note right: 422 Unprocessable Entity\n+ поля для исправления
  stop
endif

|Администратор|
:11. Escalation критических ошибок\n(manual approval);

|#AntiqueWhite|Реестр полисов|
stop

@enduml IssueDMS_Policy_v2
