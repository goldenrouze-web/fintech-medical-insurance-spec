{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "insured-person",
  "title": "Застрахованное лицо",
  "type": "object",
  "additionalProperties": false,
  "required": ["full_name", "birth_date", "passport_number"],
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "ФИО полностью, как в паспорте"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Дата рождения YYYY-MM-DD"
    },
    "passport_number": {
      "type": "string",
      "pattern": "^\\d{4}\\s?\\d{6}$",
      "description": "Серия и номер паспорта РФ, 4510 123456 или 4510123456"
    },
    "snils": {
      "type": "string",
      "pattern": "^\\d{3}-\\d{3}-\\d{3}\\s?\\d{2}$",
      "description": "СНИЛС, 123-456-789 00. Необязательный, но желательно."
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+7\\d{10}$",
      "description": "Телефон +79161234567"
    },
    "relationship": {
      "type": "string",
      "enum": ["self", "spouse", "child", "parent"],
      "default": "self",
      "description": "Кем приходится страхователю"
    }
  }
}
