CREATE TABLE POLIS (
    polis_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    polis_number VARCHAR(50) NOT NULL,
    issue_date DATE NOT NULL,
    expiry_date DATE NOT NULL,
    status VARCHAR(9),
    client_id UUID NOT NULL REFERENCES СLIENT(client_id) ON DELETE CASCADE,
    CONSTRAINT chk_policy_dates CHECK (issue_date < expiry_date)
);

