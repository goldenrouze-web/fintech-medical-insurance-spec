-- Создание таблицы POLIS (Полисы)
CREATE TABLE POLIS (
    polis_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    polis_number VARCHAR(50) NOT NULL,
    issue_date DATE NOT NULL,
    expiry_date DATE NOT NULL,
    status VARCHAR(20),
    client_id UUID NOT NULL REFERENCES KLIENT(client_id) ON DELETE CASCADE,
    CONSTRAINT chk_policy_dates CHECK (issue_date < expiry_date),
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT chk_updated_after_created CHECK (updated_at >= created_at)
);

