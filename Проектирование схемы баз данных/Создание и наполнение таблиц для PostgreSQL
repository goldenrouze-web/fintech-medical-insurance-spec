-- Таблица связи POLIS_PRZKADA
CREATE TABLE POLIS_PRZKADA (
    polis_id UUID NOT NULL REFERENCES POLIS(polis_id) ON DELETE CASCADE,
    insurance_id UUID NOT NULL REFERENCES PRZKADA(insurance_id) ON DELETE CASCADE,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    PRIMARY KEY (polis_id, insurance_id),
    CONSTRAINT chk_updated_after_created CHECK (updated_at >= created_at)
);

-- Наполнение
INSERT INTO POLIS_PRZKADA (polis_id, insurance_id)
VALUES
    (
        (SELECT id FROM POLIS WHERE polis_number = 'POL-2024-001'),
        (SELECT id FROM PRZKADA WHERE insurance_name = 'Росгосстрах')
    ), RETURNING id,
    (
        (SELECT id FROM POLIS WHERE polis_number = 'POL-2024-001'),
        (SELECT id FROM PRZKADA WHERE insurance_name = 'АльфаСтрахование')
    ), RETURNING id,
    (
        (SELECT id FROM POLIS WHERE polis_number = 'POL-2024-002'),
        (SELECT id FROM PRZKADA WHERE insurance_name = 'Ингосстрах')
    ), RETURNING id;


