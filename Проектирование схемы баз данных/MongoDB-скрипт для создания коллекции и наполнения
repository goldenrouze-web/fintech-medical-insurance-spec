// Создание коллекции и схемы
use("dms_database");

db.createCollection("POLIS", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["polis_id", "polis_number", "issue_date", "expiry_date", "status", "client", "insurance", "programs", "doctor"],
      properties: {
        polis_id: { bsonType: "objectId" },
        polis_number: { bsonType: "string", pattern: "^DM-[0-9]{4}-[0-9]{3}$" },
        issue_date: { bsonType: "date" },
        expiry_date: { bsonType: "date" },
        status: { bsonType: "string", enum: ["ACTIVE", "EXPIRED", "CANCELLED", "PENDING"] },
        client: { bsonType: "object" },
        insurance: { bsonType: "array", minItems: 1 },
        programs: { bsonType: "array", minItems: 1 },
        doctor: { bsonType: "object" }
      }
    }
  },
  validationLevel: "strict",
  validationAction: "error"
});

// Индексы
db.POLIS.createIndex({ polis_number: 1 }, { unique: true });
db.POLIS.createIndex({ client.client_id: 1 });
db.POLIS.createIndex({ status: 1 });

