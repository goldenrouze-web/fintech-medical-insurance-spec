CREATE SCHEMA IF NOT EXISTS dms;

SET search_path TO dms, public;

CREATE TABLE KLIENT (
    client_id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    surname VARCHAR(100) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    middle_name VARCHAR(100),
    birth_date DATE NOT NULL,
    phone VARCHAR(20),
    email VARCHAR(100),
    birth_place VARCHAR(200),
    citizenship VARCHAR(50) DEFAULT 'RU'
);

CREATE TABLE POLIS (
    polis_id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    polis_number VARCHAR(50) UNIQUE NOT NULL,
    issue_date DATE NOT NULL,
    expiry_date DATE NOT NULL,
    status VARCHAR(20) DEFAULT 'ACTIVE',
    client_id INT NOT NULL REFERENCES KLIENT(client_id)
);

CREATE TABLE PRZKADA (
    insurance_id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    insurance_name VARCHAR(200) NOT NULL,
    contact_phone VARCHAR(20),
    contact_email VARCHAR(100)
);

CREATE TABLE POLIS_PRZKADA (
    polis_id INT NOT NULL REFERENCES POLIS(polis_id),
    insurance_id INT NOT NULL REFERENCES PRZKADA(insurance_id),
    PRIMARY KEY (polis_id, insurance_id)
);

CREATE TABLE TECHNICH (
    tech_id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    tech_name VARCHAR(150) NOT NULL,
    description TEXT
);

CREATE TABLE POLIS_TECHNICH (
    polis_id INT NOT NULL REFERENCES POLIS(polis_id),
    tech_id INT NOT NULL REFERENCES TECHNICH(tech_id),
    PRIMARY KEY (polis_id, tech_id)
);

CREATE TABLE VRACH (
    doctor_id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    surname VARCHAR(100) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    specialization VARCHAR(150),
    license_number VARCHAR(50) UNIQUE
);

CREATE TABLE POLIS_VRACH (
    polis_id INT NOT NULL REFERENCES POLIS(polis_id),
    doctor_id INT NOT NULL REFERENCES VRACH(doctor_id),
    PRIMARY KEY (polis_id, doctor_id)
);

-- Indexes
CREATE INDEX idx_polis_client ON POLIS(client_id);
CREATE INDEX idx_polis_number ON POLIS(polis_number);
CREATE INDEX idx_klient_email ON KLIENT(email);
