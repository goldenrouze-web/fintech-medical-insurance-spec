
json
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "https://github.com/goldenrouze-web/fintech-medical-insurance-spec/schema/polis.schema.json",
  "title": "DMS Policy",
  "description": "Schema для полиса ДМС",
  "type": "object",
  "required": ["polis_id", "polis_number", "issue_date", "expiry_date", "status", "client", "insurance", "programs", "doctor"],
  "properties": {
    "polis_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$",
      "description": "ObjectId MongoDB"
    },
    "polis_number": {
      "type": "string",
      "pattern": "^DM-[0-9]{4}-[0-9]{3}$",
      "minLength": 12,
      "maxLength": 12
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Дата выдачи полиса"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Дата окончания полиса"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "EXPIRED", "CANCELLED", "PENDING"],
      "default": "ACTIVE"
    },
    "client": {
      "$ref": "#/definitions/client"
    },
    "insurance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/insurance"
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/program"
      }
    },
    "doctor": {
      "$ref": "#/definitions/doctor"
    }
  },
  "definitions": {
    "client": {
      "type": "object",
      "required": ["client_id", "surname", "first_name", "birth_date", "citizenship"],
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "middle_name": {
          "type": "string",
          "maxLength": 100
        },
        "birth_date": {
          "type": "string",
          "format": "date"
        },
        "phone": {
          "type": "string",
          "pattern": "^+?[0-9]{10,20}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 100
        },
        "birth_place": {
          "type": "string",
          "maxLength": 200
        },
        "citizenship": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "default": "RU"
        }
      }
    },
    "insurance": {
      "type": "object",
      "required": ["insurance_id", "insurance_name"],
      "properties": {
        "insurance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "insurance_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contact_phone": {
          "type": "string",
          "pattern": "^+?[0-9]{10,20}$"
        },
        "contact_email": {
          "type": "string",
          "format": "email",
          "maxLength": 100
        }
      }
    },
    "program": {
      "type": "object",
      "required": ["tech_id", "tech_name"],
      "properties": {
        "tech_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "tech_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "doctor": {
      "type": "object",
      "required": ["doctor_id", "surname", "first_name"],
      "properties": {
        "doctor_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "specialization": {
          "type": "string",
          "maxLength": 150
        },
        "license_number": {
          "type": "string",
          "pattern": "^LIC-[0-9]{5}$",
          "maxLength": 50
        }
      }
    }
  }
}
