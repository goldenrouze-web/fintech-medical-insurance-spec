{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "dms-policy-create",
  "title": "Создание полиса",
  "description": "POST /dms/policies, тело запроса",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_type",
    "policyholder_id",
    "coverage_program_id",
    "insured_persons",
    "valid_from",
    "valid_to"
  ],
  "properties": {
    "program_type": {
      "type": "string",
      "enum": ["individual", "family", "corporate"]
    },
    "policyholder_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "кто платит"
    },
    "coverage_program_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "insured_persons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["full_name", "birth_date", "passport_number"],
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "birth_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "passport_number": {
            "type": "string",
            "pattern": "^\\d{4}\\s?\\d{6}$",
            "description": "серия + номер, 4510 123456 или слитно"
          },
          "snils": {
            "type": "string",
            "pattern": "^\\d{3}-\\d{3}-\\d{3}\\s?\\d{2}$"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+7\\d{10}$"
          },
          "relationship": {
            "type": "string",
            "enum": ["self", "spouse", "child", "parent"],
            "default": "self"
          }
        }
      }
    },
    "valid_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "не раньше завтра"
    },
    "valid_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "3, 6 или 12 мес от valid_from, проверка на бэке"
    }
  }
}
