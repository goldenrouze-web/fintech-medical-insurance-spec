asyncapi: 3.0.0

info:
  title: MedInsure policy service events
  version: 1.0.0
  description: Асинхронные события сервиса полисов ДМС

defaultContentType: application/json

channels:

  application.created:
    address: dms.applications.created
    description: Новая заявка на полис после POST /dms/policies
    messages:
      msg:
        $ref: '#/components/messages/ApplicationCreated'

  payment.confirmed:
    address: dms.payments.confirmed
    description: Оплата прошла, billing обработал webhook
    messages:
      msg:
        $ref: '#/components/messages/PaymentConfirmed'

  payment.failed:
    address: dms.payments.failed
    description: Платёж не прошёл, клиенту уходит уведомление
    messages:
      msg:
        $ref: '#/components/messages/PaymentFailed'

  policy.issued:
    address: dms.policies.issued
    description: Полис выпущен, PDF готов
    messages:
      msg:
        $ref: '#/components/messages/PolicyIssued'

  policy.cancelled:
    address: dms.policies.cancelled
    description: Полис отменён, расторжение или таймаут оплаты
    messages:
      msg:
        $ref: '#/components/messages/PolicyCancelled'

operations:

  pub-app-created:
    action: send
    channel:
      $ref: '#/channels/application.created'
    description: Публикуем после создания заявки

  pub-payment-ok:
    action: send
    channel:
      $ref: '#/channels/payment.confirmed'
    description: После успешной проверки webhook

  pub-payment-fail:
    action: send
    channel:
      $ref: '#/channels/payment.failed'
    description: Webhook пришёл со статусом failed

  consume-payment-ok:
    action: receive
    channel:
      $ref: '#/channels/payment.confirmed'
    description: Генерируем PDF полиса и регистрируем в ЕГИС

  pub-policy-issued:
    action: send
    channel:
      $ref: '#/channels/policy.issued'
    description: Кидаем после того как PDF залит в S3

  pub-policy-cancelled:
    action: send
    channel:
      $ref: '#/channels/policy.cancelled'
    description: При расторжении или когда сессия оплаты протухла

components:

  messages:

    ApplicationCreated:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/AppCreatedEvt'

    PaymentConfirmed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayOkEvt'

    PaymentFailed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayFailEvt'

    PolicyIssued:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyIssuedEvt'

    PolicyCancelled:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyCancelEvt'

  schemas:

    CEHeaders:
      type: object
      description: Заголовки CloudEvents для всех событий в Kafka
      required: [ce_id, ce_type, ce_source, ce_specversion, ce_time]
      properties:
        ce_id:
          type: string
          format: uuid
          description: ID события
        ce_type:
          type: string
          description: Тип события, dms.application.created и т.д.
        ce_source:
          type: string
          description: Сервис-отправитель, policy-service
        ce_specversion:
          type: string
          description: Версия спецификации CloudEvents, сейчас 1.0
        ce_time:
          type: string
          format: date-time
          description: Время создания события, UTC

    AppCreatedEvt:
      type: object
      description: Тело события при создании заявки на полис
      additionalProperties: false
      required:
        - application_id
        - policyholder_id
        - coverage_program_id
        - program_type
        - insured_persons
        - valid_from
        - valid_to
        - created_at
      properties:
        application_id:
          type: string
          format: uuid
          description: ID заявки
        policyholder_id:
          type: string
          format: uuid
          description: Страхователь
        coverage_program_id:
          type: string
          format: uuid
          description: Программа покрытия
        program_type:
          type: string
          enum: [individual, family, corporate]
          description: Тип программы
        insured_persons:
          type: array
          description: Застрахованные лица
          minItems: 1
          maxItems: 20
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name:
                type: string
                maxLength: 200
                description: ФИО
              birth_date:
                type: string
                format: date
                description: Дата рождения
              passport_number:
                type: string
                description: Серия и номер паспорта РФ
              snils:
                type: string
                description: СНИЛС
              phone:
                type: string
                description: Телефон
              relationship:
                type: string
                enum: [self, spouse, child, parent]
                description: Кем приходится страхователю
        valid_from:
          type: string
          format: date
          description: Начало действия полиса
        valid_to:
          type: string
          format: date
          description: Окончание действия полиса
        created_at:
          type: string
          format: date-time
          description: Когда создана заявка

    PayOkEvt:
      type: object
      description: Платёж прошёл успешно
      additionalProperties: false
      required: [payment_id, policy_id, amount, currency, paid_at]
      properties:
        payment_id:
          type: string
          description: ID платежа в шлюзе
        policy_id:
          type: string
          format: uuid
          description: ID полиса
        amount:
          type: number
          minimum: 0.01
          description: Сумма платежа в рублях
        currency:
          type: string
          description: Валюта платежа, сейчас RUB
        paid_at:
          type: string
          format: date-time
          description: Время проведения платежа

    PayFailEvt:
      type: object
      description: Платёж не прошёл
      required: [payment_id, policy_id, failure_reason, failed_at]
      properties:
        payment_id:
          type: string
          description: ID платежа в шлюзе
        policy_id:
          type: string
          format: uuid
          description: ID полиса
        failure_reason:
          type: string
          description: Причина отказа от шлюза
        failed_at:
          type: string
          format: date-time
          description: Время отказа

    PolicyIssuedEvt:
      type: object
      description: Полис выпущен, PDF готов, можно рассылать клиенту
      additionalProperties: false
      required:
        - policy_id
        - policy_number
        - policyholder_id
        - status
        - program_type
        - coverage_program_id
        - valid_from
        - valid_to
        - premium_amount
        - pdf_uri
        - issued_at
      properties:
        policy_id:
          type: string
          format: uuid
          description: ID полиса
        policy_number:
          type: string
          description: Номер полиса
        policyholder_id:
          type: string
          format: uuid
          description: Страхователь
        status:
          type: string
          enum: [active, policy_pending_registration]
          description: Статус полиса после выпуска
        program_type:
          type: string
          enum: [individual, family, corporate]
          description: Тип программы
        coverage_program_id:
          type: string
          format: uuid
          description: Программа покрытия
        insured_persons:
          type: array
          description: Застрахованные лица из полиса
          minItems: 1
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name:
                type: string
                description: ФИО
              birth_date:
                type: string
                format: date
                description: Дата рождения
              passport_number:
                type: string
                description: Серия и номер паспорта
              snils:
                type: string
                description: СНИЛС
              phone:
                type: string
                description: Телефон
        valid_from:
          type: string
          format: date
          description: С какой даты действует
        valid_to:
          type: string
          format: date
          description: По какую дату действует
        premium_amount:
          type: number
          minimum: 0
          description: Страховая премия в рублях
        pdf_uri:
          type: string
          format: uri
          description: PDF полиса в S3
        issued_at:
          type: string
          format: date-time
          description: Время выпуска полиса

    PolicyCancelEvt:
      type: object
      description: Полис отменён
      additionalProperties: false
      required: [policy_id, policy_number, policyholder_id, cancellation_reason, refund_amount, cancelled_at]
      properties:
        policy_id:
          type: string
          format: uuid
          description: ID полиса
        policy_number:
          type: string
          description: Номер полиса
        policyholder_id:
          type: string
          format: uuid
          description: Страхователь
        cancellation_reason:
          type: string
          enum: [client_request, payment_timeout, payment_expired]
          description: Причина отмены полиса
        refund_amount:
          type: number
          minimum: 0
          description: Сумма возврата в рублях
        cancelled_at:
          type: string
          format: date-time
          description: Время отмены
