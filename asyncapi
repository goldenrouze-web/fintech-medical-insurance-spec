asyncapi: 3.0.0

info:
  title: MedInsure policy service events
  version: 1.0.0
  description: Асинхронные события сервиса полисов ДМС

defaultContentType: application/json

channels:

  application.created:
    address: dms.applications.created
    description: Новая заявка на полис после POST /dms/policies
    messages:
      msg:
        $ref: '#/components/messages/ApplicationCreated'

  payment.confirmed:
    address: dms.payments.confirmed
    description: Оплата прошла, billing обработал webhook
    messages:
      msg:
        $ref: '#/components/messages/PaymentConfirmed'

  payment.failed:
    address: dms.payments.failed
    description: Платёж не прошёл
    messages:
      msg:
        $ref: '#/components/messages/PaymentFailed'

  policy.issued:
    address: dms.policies.issued
    description: Полис выпущен, PDF готов
    messages:
      msg:
        $ref: '#/components/messages/PolicyIssued'

  policy.cancelled:
    address: dms.policies.cancelled
    description: Полис отменён (расторжение или таймаут оплаты)
    messages:
      msg:
        $ref: '#/components/messages/PolicyCancelled'

operations:

  pub-app-created:
    action: send
    channel:
      $ref: '#/channels/application.created'
    description: Публикуем после создания заявки

  pub-payment-ok:
    action: send
    channel:
      $ref: '#/channels/payment.confirmed'
    description: После проверки webhook от шлюза

  pub-payment-fail:
    action: send
    channel:
      $ref: '#/channels/payment.failed'
    description: После проверки webhook от шлюза

  consume-payment-ok:
    action: receive
    channel:
      $ref: '#/channels/payment.confirmed'
    description: Генерация PDF и регистрация в ЕГИС

  pub-policy-issued:
    action: send
    channel:
      $ref: '#/channels/policy.issued'
    description: После генерации PDF

  pub-policy-cancelled:
    action: send
    channel:
      $ref: '#/channels/policy.cancelled'

components:

  messages:

    ApplicationCreated:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/AppCreatedEvt'

    PaymentConfirmed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayOkEvt'

    PaymentFailed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayFailEvt'

    PolicyIssued:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyIssuedEvt'

    PolicyCancelled:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyCancelEvt'

  schemas:

    CEHeaders:
      type: object
      description: CloudEvents 1.0 заголовки для Kafka
      required: [ce_id, ce_type, ce_source, ce_specversion, ce_time]
      properties:
        ce_id:
          type: string
          format: uuid
          description: Уникальный ID события
        ce_type:
          type: string
          description: Тип события, например dms.application.created
        ce_source:
          type: string
          description: Источник, например policy-service
        ce_specversion:
          type: string
          enum: ["1.0"]
        ce_time:
          type: string
          format: date-time

    AppCreatedEvt:
      type: object
      description: Данные новой заявки на полис
      additionalProperties: false
      required:
        - application_id
        - policyholder_id
        - coverage_program_id
        - program_type
        - insured_persons
        - valid_from
        - valid_to
        - created_at
      properties:
        application_id:
          type: string
          format: uuid
        policyholder_id:
          type: string
          format: uuid
          description: Кто оформляет полис
        coverage_program_id:
          type: string
          format: uuid
          description: Программа покрытия из справочника
        program_type:
          type: string
          enum: [individual, family, corporate]
        insured_persons:
          type: array
          description: Список застрахованных
          minItems: 1
          maxItems: 20
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name:
                type: string
                maxLength: 200
                description: ФИО как в паспорте
              birth_date:
                type: string
                format: date
              passport_number:
                type: string
                pattern: '^\d{4}\s?\d{6}$'
                description: Серия и номер, 4510 123456
              snils:
                type: string
                pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$'
                description: СНИЛС, необязательный
              phone:
                type: string
                pattern: '^\+7\d{10}$'
              relationship:
                type: string
                enum: [self, spouse, child, parent]
        valid_from:
          type: string
          format: date
          description: Начало действия полиса
        valid_to:
          type: string
          format: date
          description: Конец действия полиса
        created_at:
          type: string
          format: date-time

    PayOkEvt:
      type: object
      description: Успешная оплата полиса
      additionalProperties: false
      required: [payment_id, policy_id, amount, currency, paid_at]
      properties:
        payment_id:
          type: string
          description: ID платежа на стороне шлюза
        policy_id:
          type: string
          format: uuid
        amount:
          type: number
          minimum: 0.01
          description: Сумма в рублях
        currency:
          type: string
          enum: [RUB]
        paid_at:
          type: string
          format: date-time

    PayFailEvt:
      type: object
      description: Неуспешная оплата
      required: [payment_id, policy_id, failure_reason, failed_at]
      properties:
        payment_id:
          type: string
          description: ID платежа на стороне шлюза
        policy_id:
          type: string
          format: uuid
        failure_reason:
          type: string
          description: Причина отказа от шлюза
        failed_at:
          type: string
          format: date-time

    PolicyIssuedEvt:
      type: object
      description: Полис выпущен, PDF сгенерирован
      additionalProperties: false
      required:
        - policy_id
        - policy_number
        - policyholder_id
        - status
        - program_type
        - coverage_program_id
        - valid_from
        - valid_to
        - premium_amount
        - pdf_uri
        - issued_at
      properties:
        policy_id:
          type: string
          format: uuid
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
          description: Номер полиса, MI-2026-00000147
        policyholder_id:
          type: string
          format: uuid
        status:
          type: string
          enum: [active, policy_pending_registration]
          description: active если ЕГИС ответил, иначе policy_pending_registration
        program_type:
          type: string
          enum: [individual, family, corporate]
        coverage_program_id:
          type: string
          format: uuid
        insured_persons:
          type: array
          minItems: 1
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name:
                type: string
              birth_date:
                type: string
                format: date
              passport_number:
                type: string
                pattern: '^\d{4}\s?\d{6}$'
              snils:
                type: string
                pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$'
              phone:
                type: string
                pattern: '^\+7\d{10}$'
        valid_from:
          type: string
          format: date
        valid_to:
          type: string
          format: date
        premium_amount:
          type: number
          minimum: 0
          description: Страховая премия в рублях
        pdf_uri:
          type: string
          format: uri
          description: Ссылка на PDF полиса в S3
        issued_at:
          type: string
          format: date-time

    PolicyCancelEvt:
      type: object
      description: Полис отменён
      additionalProperties: false
      required: [policy_id, policy_number, policyholder_id, cancellation_reason, refund_amount, cancelled_at]
      properties:
        policy_id:
          type: string
          format: uuid
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id:
          type: string
          format: uuid
        cancellation_reason:
          type: string
          enum: [client_request, payment_timeout, payment_expired]
          description: client_request при расторжении, payment_timeout через 24ч, payment_expired если сессия шлюза протухла
        refund_amount:
          type: number
          minimum: 0
          description: Возврат pro rata в рублях
        cancelled_at:
          type: string
          format: date-time
