asyncapi: 3.0.0

info:
  title: MedInsure events
  version: 1.0.0
  description: |
    Kafka внутри, webhook от платёжки снаружи.
    Нотификации для документации, кодогенерацию не делаем.
  contact:
    email: dms-api@example.com

defaultContentType: application/json

servers:

  kafka:
    host: kafka:9092
    protocol: kafka
    description: 3 партиции на топик

  payment-gw:
    host: '{gatewayHost}'
    protocol: https
    variables:
      gatewayHost:
        default: sandbox.gateway.example.com

  smtp:
    host: smtp.example.com:587
    protocol: smtp

  sms-gw:
    host: sms.example.com
    protocol: https


channels:

  application.created:
    address: dms.applications.created
    description: outbox после INSERT, status=NEW
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ApplicationCreated'

  application.rejected:
    address: dms.applications.rejected
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ApplicationRejected'

  # -- оплата --

  payment.confirmed:
    address: dms.payments.confirmed
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PaymentConfirmed'
    description: billing кладёт после webhook, дальше PDF + ЕГИС

  payment.failed:
    address: dms.payments.failed
    description: |
      платёж упал, клиенту пуш,
      policy-module 24ч таймер на повтор
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PaymentFailed'

  policy.issued:
    address: dms.policies.issued
    description: |
      PDF сгенерён. ACTIVE если ЕГИС ок,
      POLICY_PENDING_REGISTRATION если нет.
      Уведомления уходят в любом случае, договорились на ретро.
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PolicyIssued'

  policy.cancelled:
    address: dms.policies.cancelled
    # таймаут / расторжение / протухла сессия шлюза
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PolicyCancelled'

  policy.expiring:
    address: dms.policies.expiring
    description: cron, 30/14/3 дня до valid_to
    messages:
      msg:
        $ref: '#/components/messages/PolicyExpiring'

  claim.submitted:
    address: dms.claims.submitted
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ClaimSubmitted'

  claim.status-changed:
    address: dms.claims.status-changed
    # submitted -> in_review -> approved/rejected/pending_docs -> paid
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ClaimStatusChanged'

  payment-callback:
    address: /webhooks/payment-callback
    description: POST от шлюза, HMAC в X-Signature
    servers:
      - $ref: '#/servers/payment-gw'
    messages:
      msg:
        $ref: '#/components/messages/PaymentCallback'

  notifications.email:
    address: notifications/email
    servers:
      - $ref: '#/servers/smtp'
    messages:
      msg:
        $ref: '#/components/messages/EmailNotification'

  notifications.sms:
    address: notifications/sms
    servers:
      - $ref: '#/servers/sms-gw'
    messages:
      msg:
        $ref: '#/components/messages/SmsNotification'


operations:

  pub-app-created:
    action: send
    channel:
      $ref: '#/channels/application.created'
    description: policy-модуль, outbox

  reject-app:
    action: send
    channel:
      $ref: '#/channels/application.rejected'

  pub-payment-ok:
    action: send
    channel:
      $ref: '#/channels/payment.confirmed'

  pub-payment-fail:
    action: send
    channel:
      $ref: '#/channels/payment.failed'

  issue-policy:
    action: send
    channel:
      $ref: '#/channels/policy.issued'

  cancel-policy:
    action: send
    channel:
      $ref: '#/channels/policy.cancelled'

  send-expiring:
    action: send
    channel:
      $ref: '#/channels/policy.expiring'

  pub-claim:
    action: send
    channel:
      $ref: '#/channels/claim.submitted'

  claim-update:
    action: send
    channel:
      $ref: '#/channels/claim.status-changed'

  # потребители

  process-application:
    action: receive
    channel:
      $ref: '#/channels/application.created'
    description: |
      андеррайтинг + KYC + тариф параллельно.
      ретрай 30с/2м/10м/1ч, потом MANUAL_REVIEW

  gen-pdf:
    action: receive
    channel:
      $ref: '#/channels/payment.confirmed'
    description: PDF (3 попытки в S3), потом ЕГИС, потом policy.issued

  on-policy-issued:
    action: receive
    channel:
      $ref: '#/channels/policy.issued'
    description: email + sms + push, каждый канал свой DLQ

  on-claim-update:
    action: receive
    channel:
      $ref: '#/channels/claim.status-changed'

  on-expiring:
    action: receive
    channel:
      $ref: '#/channels/policy.expiring'

  handle-callback:
    action: receive
    channel:
      $ref: '#/channels/payment-callback'
    description: |
      HMAC проверка. Битая подпись = 401.
      succeeded -> payment.confirmed
      failed -> payment.failed
      refunded -> возврат

  do-email:
    action: send
    channel:
      $ref: '#/channels/notifications.email'

  do-sms:
    action: send
    channel:
      $ref: '#/channels/notifications.sms'


components:

  messages:

    ApplicationCreated:
      name: ApplicationCreated
      summary: outbox
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/AppCreatedEvt'

    ApplicationRejected:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/AppRejectedEvt'

    PaymentConfirmed:
      name: PaymentConfirmed
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayOkEvt'

    PaymentFailed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayFailEvt'

    PolicyIssued:
      name: PolicyIssued
      summary: PDF готов
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyIssuedEvt'

    PolicyCancelled:
      name: PolicyCancelled
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyCancelEvt'

    PolicyExpiring:
      # планировщик без CE-заголовков
      # TODO нужны ли CE тут?
      payload:
        $ref: '#/components/schemas/ExpiringEvt'

    ClaimSubmitted:
      name: ClaimSubmitted
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/ClaimNewEvt'

    ClaimStatusChanged:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/ClaimUpdateEvt'

    PaymentCallback:
      name: PaymentCallback
      contentType: application/json
      headers:
        type: object
        required: [X-Signature]
        properties:
          X-Signature:
            type: string
      payload:
        $ref: '#/components/schemas/GwCallback'

    EmailNotification:
      payload:
        $ref: '#/components/schemas/EmailMsg'

    SmsNotification:
      payload:
        $ref: '#/components/schemas/SmsMsg'


  schemas:

    CEHeaders:
      type: object
      required: [ce_id, ce_type, ce_source, ce_specversion, ce_time]
      properties:
        ce_id: { type: string, format: uuid }
        ce_type: { type: string }
        ce_source: { type: string }
        ce_specversion:
          type: string
          enum: ["1.0"]
        ce_time: { type: string, format: date-time }

    AppCreatedEvt:
      type: object
      additionalProperties: false
      required:
        - application_id
        - policyholder_id
        - coverage_program_id
        - program_type
        - insured_persons
        - valid_from
        - valid_to
        - status
        - created_at
      properties:
        application_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        coverage_program_id: { type: string, format: uuid }
        program_type:
          type: string
          enum: [individual, family, corporate]
        insured_persons:
          type: array
          minItems: 1
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name: { type: string, maxLength: 200 }
              birth_date: { type: string, format: date }
              passport_number:
                type: string
                pattern: '^\d{4}\s?\d{6}$'
              snils: { type: string, pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$' }
              phone: { type: string, pattern: '^\+7\d{10}$' }
              relationship:
                type: string
                enum: [self, spouse, child, parent]
        valid_from: { type: string, format: date }
        valid_to: { type: string, format: date }
        status: { type: string, enum: [new] }
        created_at: { type: string, format: date-time }

    AppRejectedEvt:
      type: object
      additionalProperties: false
      required: [application_id, policyholder_id, reason_code, reason_message, rejected_at]
      properties:
        application_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        reason_code:
          type: string
          enum: [underwriting_failed, kyc_failed, antifraud_failed, manual_rejection]
        reason_message:
          type: string
          description: для клиента
        rejected_at: { type: string, format: date-time }

    PayOkEvt:
      type: object
      additionalProperties: false
      required: [payment_id, policy_id, application_id, amount, currency, paid_at]
      properties:
        payment_id: { type: string }
        policy_id: { type: string, format: uuid }
        application_id: { type: string, format: uuid }
        amount:
          type: number
          minimum: 0.01
        currency: { type: string, enum: [RUB] }
        paid_at: { type: string, format: date-time }

    PayFailEvt:
      type: object
      # без additionalProperties, шлюз может дописать
      required: [payment_id, policy_id, application_id, failure_reason, failed_at]
      properties:
        payment_id: { type: string }
        policy_id: { type: string, format: uuid }
        application_id: { type: string, format: uuid }
        failure_reason: { type: string }
        failed_at: { type: string, format: date-time }

    PolicyIssuedEvt:
      type: object
      additionalProperties: false
      required:
        - policy_id
        - policy_number
        - policyholder_id
        - status
        - program_type
        - coverage_program_id
        - valid_from
        - valid_to
        - premium_amount
        - pdf_uri
        - issued_at
      properties:
        policy_id: { type: string, format: uuid }
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id: { type: string, format: uuid }
        status:
          type: string
          enum: [active, policy_pending_registration]
        program_type:
          type: string
          enum: [individual, family, corporate]
        coverage_program_id: { type: string, format: uuid }
        insured_persons:
          type: array
          minItems: 1
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name: { type: string }
              birth_date: { type: string, format: date }
              passport_number: { type: string, pattern: '^\d{4}\s?\d{6}$' }
              snils: { type: string }
              phone: { type: string }
              relationship: { type: string }
        valid_from: { type: string, format: date }
        valid_to: { type: string, format: date }
        premium_amount: { type: number, minimum: 0 }
        pdf_uri: { type: string, format: uri }
        issued_at: { type: string, format: date-time }

    PolicyCancelEvt:
      type: object
      additionalProperties: false
      required: [policy_id, policy_number, policyholder_id, cancellation_reason, refund_amount, cancelled_at]
      properties:
        policy_id: { type: string, format: uuid }
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id: { type: string, format: uuid }
        cancellation_reason:
          type: string
          enum: [client_request, payment_timeout, payment_expired]
        refund_amount:
          type: number
          minimum: 0
          # pro rata
        cancelled_at: { type: string, format: date-time }

    ExpiringEvt:
      type: object
      required: [policy_id, policy_number, policyholder_id, valid_to, days_remaining]
      properties:
        policy_id: { type: string, format: uuid }
        policy_number: { type: string }
        policyholder_id: { type: string, format: uuid }
        valid_to: { type: string, format: date }
        days_remaining:
          type: integer
          enum: [30, 14, 3]

    ClaimNewEvt:
      type: object
      additionalProperties: false
      required: [claim_id, policy_id, policyholder_id, service_type, service_date, clinic_name, claimed_amount, documents, submitted_at]
      properties:
        claim_id: { type: string, format: uuid }
        policy_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        service_type: { type: string }
        service_date: { type: string, format: date }
        clinic_name: { type: string }
        claimed_amount:
          type: number
          minimum: 0.01
        documents:
          type: array
          maxItems: 10
          items:
            type: object
            required: [document_id, file_name, content_type, size_bytes, uri]
            properties:
              document_id: { type: string, format: uuid }
              file_name: { type: string }
              content_type:
                type: string
                enum: [image/jpeg, image/png, application/pdf]
              size_bytes:
                type: integer
                maximum: 10485760
              uri: { type: string, format: uri }
        submitted_at: { type: string, format: date-time }

    ClaimUpdateEvt:
      type: object
      additionalProperties: false
      required: [claim_id, policy_id, policyholder_id, previous_status, new_status, changed_at]
      properties:
        claim_id: { type: string, format: uuid }
        policy_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        previous_status:
          type: string
          enum: [submitted, in_review, pending_docs, approved, rejected, paid]
        new_status:
          type: string
          enum: [submitted, in_review, pending_docs, approved, rejected, paid]
        approved_amount: { type: number, minimum: 0 }
        franchise_deduction: { type: number, minimum: 0 }
        rejection_reason: { type: string }
        additional_docs_request: { type: string }
        changed_by: { type: string, format: uuid }
        changed_at: { type: string, format: date-time }

    GwCallback:
      type: object
      additionalProperties: false
      required: [payment_id, policy_id, status, amount, paid_at]
      properties:
        payment_id: { type: string }
        policy_id: { type: string, format: uuid }
        status:
          type: string
          enum: [succeeded, failed, refunded]
        amount: { type: number, minimum: 0.01 }
        paid_at: { type: string, format: date-time }

    EmailMsg:
      type: object
      additionalProperties: false
      required: [notification_id, notification_type, recipient_email, subject, body_template, created_at]
      properties:
        notification_id: { type: string, format: uuid }
        notification_type:
          type: string
          enum: [policy_issued, fiscal_receipt, claim_submitted, claim_status_changed, expiring_reminder, password_reset, application_rejected]
        recipient_email: { type: string, format: email }
        subject: { type: string }
        body_template: { type: string }
        template_params:
          type: object
        attachments:
          type: array
          items:
            type: object
            properties:
              file_name: { type: string }
              content_type: { type: string }
              uri: { type: string, format: uri }
        created_at: { type: string, format: date-time }

    SmsMsg:
      type: object
      required: [notification_id, notification_type, recipient_phone, message_text, created_at]
      properties:
        notification_id: { type: string, format: uuid }
        notification_type:
          type: string
          enum: [otp, policy_issued, expiring_reminder]
        recipient_phone:
          type: string
          pattern: '^\+7\d{10}$'
        message_text:
          type: string
          maxLength: 160
        created_at: { type: string, format: date-time }
