asyncapi: 3.0.0

info:
  title: MedInsure policy service events
  version: 1.0.0
  description: Асинхронные события сервиса полисов ДМС

defaultContentType: application/json

channels:

  application.created:
    address: dms.applications.created
    messages:
      msg:
        $ref: '#/components/messages/ApplicationCreated'

  payment.confirmed:
    address: dms.payments.confirmed
    messages:
      msg:
        $ref: '#/components/messages/PaymentConfirmed'

  payment.failed:
    address: dms.payments.failed
    messages:
      msg:
        $ref: '#/components/messages/PaymentFailed'

  policy.issued:
    address: dms.policies.issued
    messages:
      msg:
        $ref: '#/components/messages/PolicyIssued'

  policy.cancelled:
    address: dms.policies.cancelled
    messages:
      msg:
        $ref: '#/components/messages/PolicyCancelled'

operations:

  pub-app-created:
    action: send
    channel:
      $ref: '#/channels/application.created'

  pub-payment-ok:
    action: send
    channel:
      $ref: '#/channels/payment.confirmed'

  pub-payment-fail:
    action: send
    channel:
      $ref: '#/channels/payment.failed'

  consume-payment-ok:
    action: receive
    channel:
      $ref: '#/channels/payment.confirmed'

  pub-policy-issued:
    action: send
    channel:
      $ref: '#/channels/policy.issued'

  pub-policy-cancelled:
    action: send
    channel:
      $ref: '#/channels/policy.cancelled'

components:

  messages:

    ApplicationCreated:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/AppCreatedEvt'

    PaymentConfirmed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayOkEvt'

    PaymentFailed:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PayFailEvt'

    PolicyIssued:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyIssuedEvt'

    PolicyCancelled:
      headers:
        $ref: '#/components/schemas/CEHeaders'
      payload:
        $ref: '#/components/schemas/PolicyCancelEvt'

  schemas:

    CEHeaders:
      type: object
      required: [ce_id, ce_type, ce_source, ce_specversion, ce_time]
      properties:
        ce_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        ce_type:
          type: string
        ce_source:
          type: string
        ce_specversion:
          type: string
          enum: ["1.0"]
        ce_time:
          type: string
          format: date-time

    AppCreatedEvt:
      type: object
      additionalProperties: false
      required:
        - application_id
        - policyholder_id
        - coverage_program_id
        - program_type
        - insured_persons
        - valid_from
        - valid_to
        - created_at
      properties:
        application_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        policyholder_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        coverage_program_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        program_type:
          type: string
          enum: [individual, family, corporate]
        insured_persons:
          type: array
          minItems: 1
          maxItems: 20
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name:
                type: string
                maxLength: 200
              birth_date:
                type: string
                pattern: '^\d{4}-\d{2}-\d{2}$'
              passport_number:
                type: string
                pattern: '^\d{4}\s?\d{6}$'
              snils:
                type: string
                pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$'
              phone:
                type: string
                pattern: '^\+7\d{10}$'
              relationship:
                type: string
                enum: [self, spouse, child, parent]
        valid_from:
          type: string
          pattern: '^\d{4}-\d{2}-\d{2}$'
        valid_to:
          type: string
          pattern: '^\d{4}-\d{2}-\d{2}$'
        created_at:
          type: string
          format: date-time

    PayOkEvt:
      type: object
      additionalProperties: false
      required: [payment_id, policy_id, amount, currency, paid_at]
      properties:
        payment_id:
          type: string
        policy_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        amount:
          type: number
          minimum: 0.01
        currency:
          type: string
          enum: [RUB]
        paid_at:
          type: string
          format: date-time

    PayFailEvt:
      type: object
      required: [payment_id, policy_id, failure_reason, failed_at]
      properties:
        payment_id:
          type: string
        policy_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        failure_reason:
          type: string
        failed_at:
          type: string
          format: date-time

    PolicyIssuedEvt:
      type: object
      additionalProperties: false
      required:
        - policy_id
        - policy_number
        - policyholder_id
        - status
        - program_type
        - coverage_program_id
        - valid_from
        - valid_to
        - premium_amount
        - pdf_uri
        - issued_at
      properties:
        policy_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        status:
          type: string
          enum: [active, policy_pending_registration]
        program_type:
          type: string
          enum: [individual, family, corporate]
        coverage_program_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        insured_persons:
          type: array
          minItems: 1
          items:
            type: object
            required: [full_name, birth_date, passport_number]
            properties:
              full_name:
                type: string
              birth_date:
                type: string
                pattern: '^\d{4}-\d{2}-\d{2}$'
              passport_number:
                type: string
                pattern: '^\d{4}\s?\d{6}$'
              snils:
                type: string
                pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$'
              phone:
                type: string
                pattern: '^\+7\d{10}$'
        valid_from:
          type: string
          pattern: '^\d{4}-\d{2}-\d{2}$'
        valid_to:
          type: string
          pattern: '^\d{4}-\d{2}-\d{2}$'
        premium_amount:
          type: number
          minimum: 0
        pdf_uri:
          type: string
          format: uri
        issued_at:
          type: string
          format: date-time

    PolicyCancelEvt:
      type: object
      additionalProperties: false
      required: [policy_id, policy_number, policyholder_id, cancellation_reason, refund_amount, cancelled_at]
      properties:
        policy_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id:
          type: string
          pattern: '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        cancellation_reason:
          type: string
          enum: [client_request, payment_timeout, payment_expired]
        refund_amount:
          type: number
          minimum: 0
        cancelled_at:
          type: string
          format: date-time
