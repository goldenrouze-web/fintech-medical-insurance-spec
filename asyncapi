asyncapi: 3.0.0

info:
  title: MedInsure async contracts
  version: 1.0.0
  description: |
    Контракты на асинхронное взаимодействие. Kafka внутри,
    webhook от платёжного шлюза снаружи. Нотификации тоже тут
    но они больше для документации, кодогенерацию с них не делаем.
  contact:
    name: DMS API Support
    email: dms-api@example.com

defaultContentType: application/json

servers:

  kafka:
    host: kafka:9092
    protocol: kafka
    description: partitions=3 на всех топиках, пока хватает

  # в проде будет другой хост, сейчас sandbox
  payment-gw:
    host: '{gatewayHost}'
    protocol: https
    description: ЮKassa sandbox
    variables:
      gatewayHost:
        default: sandbox.gateway.example.com

  smtp:
    host: smtp.example.com:587
    protocol: smtp
    # TODO переехать на SES после MVP

  sms:
    host: sms.example.com
    protocol: https

# ------- каналы -------

channels:

  # заявки

  application.created:
    address: dms.applications.created
    description: |
      Новая заявка на полис. Попадает через transactional outbox
      сразу после INSERT (status=NEW), воркер подхватывает.
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ApplicationCreated'

  application.rejected:
    address: dms.applications.rejected
    # KYC или андеррайтинг завернули, notification шлёт отказ
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ApplicationRejected'

  # платежи

  payment.confirmed:
    address: dms.payments.confirmed
    description: Billing положил после проверки webhook. Дальше генерация PDF + ЕГИС.
    messages:
      msg:
        $ref: '#/components/messages/PaymentConfirmed'

  payment.failed:
    address: dms.payments.failed
    description: |
      Платёж не прошёл. Клиенту уведомление,
      policy-module ставит таймер 24ч на повторную попытку.
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PaymentFailed'

  policy.issued:
    address: dms.policies.issued
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PolicyIssued'
    description: |
      PDF готов. Статус ACTIVE если ЕГИС ответил,
      POLICY_PENDING_REGISTRATION если ещё нет.
      Уведомления уходят в обоих случаях, решили на ретро
      что клиент не должен ждать реестр.

  policy.cancelled:
    address: dms.policies.cancelled
    # расторжение / таймаут оплаты / протухшая сессия шлюза
    description: Billing считает возврат pro rata, notification шлёт клиенту.
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/PolicyCancelled'

  policy.expiring:
    address: dms.policies.expiring
    description: Cron за 30/14/3 дня до valid_to, notification рассылает напоминания.
    messages:
      msg:
        $ref: '#/components/messages/PolicyExpiring'

  claim.submitted:
    address: dms.claims.submitted
    description: Клиент подал заявление на выплату. Подтверждение на email + кейс в очередь.
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ClaimSubmitted'

  claim.status-changed:
    address: dms.claims.status-changed
    # submitted -> in_review -> approved/rejected/pending_docs -> paid
    servers:
      - $ref: '#/servers/kafka'
    messages:
      msg:
        $ref: '#/components/messages/ClaimStatusChanged'

  # webhook

  payment-callback:
    address: /webhooks/payment-callback
    description: Шлюз POST-ит после обработки. HMAC-SHA256 в X-Signature.
    servers:
      - $ref: '#/servers/payment-gw'
    messages:
      msg:
        $ref: '#/components/messages/PaymentCallback'

  notifications.email:
    address: notifications/email
    description: Письма клиентам (PDF, чек, claim, напоминания, сброс пароля).
    servers:
      - $ref: '#/servers/smtp'
    messages:
      msg:
        $ref: '#/components/messages/EmailNotification'

  notifications.sms:
    address: notifications/sms
    # OTP, полис оформлен, скоро кончится
    servers:
      - $ref: '#/servers/sms'
    messages:
      msg:
        $ref: '#/components/messages/SmsNotification'


# ------- операции -------

operations:

  # produce

  pub-application-created:
    action: send
    channel:
      $ref: '#/channels/application.created'
    summary: Новая заявка
    description: policy-модуль, outbox

  application-rejected:
    action: send
    channel:
      $ref: '#/channels/application.rejected'
    summary: Заявка завёрнута

  pub-payment-ok:
    action: send
    channel:
      $ref: '#/channels/payment.confirmed'
    summary: Оплата прошла

  pub-payment-fail:
    action: send
    channel:
      $ref: '#/channels/payment.failed'
    summary: Платёж не прошёл

  policy-issued:
    action: send
    channel:
      $ref: '#/channels/policy.issued'
    summary: Полис выпущен
    description: уходит после PDF, даже если ЕГИС ещё не ответил

  pub-policy-cancelled:
    action: send
    channel:
      $ref: '#/channels/policy.cancelled'
    summary: Полис отменён

  expiring-reminder:
    action: send
    channel:
      $ref: '#/channels/policy.expiring'
    summary: Напоминание

  pub-claim-submitted:
    action: send
    channel:
      $ref: '#/channels/claim.submitted'
    summary: Новый claim

  claim-status-update:
    action: send
    channel:
      $ref: '#/channels/claim.status-changed'
    summary: Статус claim

  # consume

  process-application:
    action: receive
    channel:
      $ref: '#/channels/application.created'
    summary: Обработка заявки
    description: |
      IN_PROGRESS, параллельно андеррайтинг + KYC + тариф.
      Ок -- PRICED. Сервис лёг -- ретрай 30с/2м/10м/1ч,
      после 4 фейлов MANUAL_REVIEW.

  generate-pdf:
    action: receive
    channel:
      $ref: '#/channels/payment.confirmed'
    summary: PDF + ЕГИС
    description: генерит PDF (3 попытки залить в S3), ЕГИС идемпотентно, потом policy.issued

  notify-issued:
    action: receive
    channel:
      $ref: '#/channels/policy.issued'
    summary: Рассылка
    description: email с PDF, SMS, push. Каждый канал отдельно, свои ретраи, свой DLQ.

  notify-claim:
    action: receive
    channel:
      $ref: '#/channels/claim.status-changed'
    summary: Уведомление по claim

  notify-expiring:
    action: receive
    channel:
      $ref: '#/channels/policy.expiring'
    summary: Напоминание клиенту

  handle-callback:
    action: receive
    channel:
      $ref: '#/channels/payment-callback'
    summary: Webhook от шлюза
    description: |
      HMAC из X-Signature. Битая подпись = 401 + инцидент.
      succeeded -> payment.confirmed, pending->active.
      failed -> payment.failed.
      refunded -> возврат.

  send-email:
    action: send
    channel:
      $ref: '#/channels/notifications.email'
    summary: Email

  send-sms:
    action: send
    channel:
      $ref: '#/channels/notifications.sms'
    summary: SMS


components:

  messages:

    ApplicationCreated:
      name: ApplicationCreated
      title: Заявка создана
      summary: через outbox
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/ApplicationCreatedEvent'

    ApplicationRejected:
      title: Отказ по заявке
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/ApplicationRejectedEvent'

    PaymentConfirmed:
      name: PaymentConfirmed
      title: Оплата ок
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/PaymentOkEvent'

    PaymentFailed:
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/PaymentFailEvent'

    PolicyIssued:
      name: PolicyIssued
      title: Полис выпущен
      summary: PDF готов, ЕГИС мог ещё не ответить
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/PolicyIssuedData'

    PolicyCancelled:
      name: PolicyCancelled
      title: Полис отменён
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/PolicyCancelledData'

    PolicyExpiring:
      payload:
        $ref: '#/components/schemas/ExpiringReminder'
      # headers не указываем, планировщик кидает без CE-обёртки
      # TODO: согласовать с Лёшей, нужны ли тут CE-заголовки

    ClaimSubmitted:
      name: ClaimSubmitted
      title: Новый claim
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/ClaimSubmittedData'

    ClaimStatusChanged:
      title: Статус claim
      headers:
        $ref: '#/components/schemas/KafkaHeaders'
      payload:
        $ref: '#/components/schemas/ClaimStatusEvent'

    PaymentCallback:
      name: PaymentCallback
      title: Callback от шлюза
      contentType: application/json
      headers:
        type: object
        required: [X-Signature]
        properties:
          X-Signature:
            type: string
            description: HMAC-SHA256 тела
      payload:
        $ref: '#/components/schemas/GatewayCallback'

    EmailNotification:
      payload:
        $ref: '#/components/schemas/EmailPayload'

    SmsNotification:
      payload:
        $ref: '#/components/schemas/SmsPayload'

  schemas:

    # CE-заголовки для kafka
    KafkaHeaders:
      type: object
      required: [ce_id, ce_type, ce_source, ce_specversion, ce_time]
      properties:
        ce_id:
          type: string
          format: uuid
        ce_type:
          type: string
        ce_source:
          type: string
        ce_specversion:
          type: string
          enum: ["1.0"]
        ce_time:
          type: string
          format: date-time

    ApplicationCreatedEvent:
      type: object
      additionalProperties: false
      required:
        - application_id
        - policyholder_id
        - coverage_program_id
        - program_type
        - insured_persons
        - valid_from
        - valid_to
        - status
        - created_at
      properties:
        application_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        coverage_program_id: { type: string, format: uuid }
        program_type:
          type: string
          enum: [individual, family, corporate]
        insured_persons:
          type: array
          minItems: 1
          items:
            $ref: '#/components/schemas/InsuredPerson'
        valid_from: { type: string, format: date }
        valid_to: { type: string, format: date }
        status: { type: string, enum: [new] }
        created_at: { type: string, format: date-time }

    ApplicationRejectedEvent:
      type: object
      additionalProperties: false
      required: [application_id, policyholder_id, reason_code, reason_message, rejected_at]
      properties:
        application_id:
          type: string
          format: uuid
        policyholder_id:
          type: string
          format: uuid
        reason_code:
          type: string
          enum: [underwriting_failed, kyc_failed, antifraud_failed, manual_rejection]
        reason_message:
          type: string
          description: текст для клиента
        rejected_at:
          type: string
          format: date-time

    # платежи

    PaymentOkEvent:
      type: object
      additionalProperties: false
      required: [payment_id, policy_id, application_id, amount, currency, paid_at]
      properties:
        payment_id: { type: string } # ID на стороне шлюза
        policy_id: { type: string, format: uuid }
        application_id: { type: string, format: uuid }
        amount:
          type: number
          minimum: 0.01
          description: рубли
        currency: { type: string, enum: [RUB] }
        paid_at: { type: string, format: date-time }

    PaymentFailEvent:
      type: object
      required: [payment_id, policy_id, application_id, failure_reason, failed_at]
      properties:
        payment_id: { type: string }
        policy_id: { type: string, format: uuid }
        application_id: { type: string, format: uuid }
        failure_reason: { type: string }
        failed_at: { type: string, format: date-time }
      # additionalProperties не ставим -- шлюз может добавить свои поля

    # полисы

    PolicyIssuedData:
      type: object
      additionalProperties: false
      required:
        - policy_id
        - policy_number
        - policyholder_id
        - status
        - program_type
        - coverage_program_id
        - valid_from
        - valid_to
        - premium_amount
        - pdf_uri
        - issued_at
      properties:
        policy_id: { type: string, format: uuid }
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id: { type: string, format: uuid }
        status:
          type: string
          enum: [active, policy_pending_registration]
        program_type: { type: string, enum: [individual, family, corporate] }
        coverage_program_id: { type: string, format: uuid }
        insured_persons:
          type: array
          minItems: 1
          items:
            $ref: '#/components/schemas/InsuredPerson'
        valid_from: { type: string, format: date }
        valid_to: { type: string, format: date }
        premium_amount: { type: number, minimum: 0 }
        pdf_uri:
          type: string
          format: uri
        issued_at: { type: string, format: date-time }

    PolicyCancelledData:
      type: object
      additionalProperties: false
      required: [policy_id, policy_number, policyholder_id, cancellation_reason, refund_amount, cancelled_at]
      properties:
        policy_id:
          type: string
          format: uuid
        policy_number:
          type: string
          pattern: '^MI-\d{4}-\d{8}$'
        policyholder_id:
          type: string
          format: uuid
        cancellation_reason:
          type: string
          enum: [client_request, payment_timeout, payment_expired]
          # client_request = расторг, pro rata
          # payment_timeout = 24ч
          # payment_expired = сессия шлюза 30мин
        refund_amount:
          type: number
          minimum: 0
        cancelled_at: { type: string, format: date-time }

    ExpiringReminder:
      type: object
      required: [policy_id, policy_number, policyholder_id, valid_to, days_remaining]
      properties:
        policy_id: { type: string, format: uuid }
        policy_number: { type: string }
        policyholder_id: { type: string, format: uuid }
        valid_to: { type: string, format: date }
        days_remaining:
          type: integer
          enum: [30, 14, 3]

    ClaimSubmittedData:
      type: object
      additionalProperties: false
      required: [claim_id, policy_id, policyholder_id, service_type, service_date, clinic_name, claimed_amount, documents, submitted_at]
      properties:
        claim_id: { type: string, format: uuid }
        policy_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        service_type:
          type: string
          # "Стоматология", "Офтальмология" и т.п., пока без enum
        service_date: { type: string, format: date }
        clinic_name: { type: string }
        claimed_amount:
          type: number
          minimum: 0.01
        documents:
          type: array
          maxItems: 10
          items:
            $ref: '#/components/schemas/ClaimDoc'
        submitted_at: { type: string, format: date-time }

    ClaimStatusEvent:
      type: object
      additionalProperties: false
      required:
        - claim_id
        - policy_id
        - policyholder_id
        - previous_status
        - new_status
        - changed_at
      properties:
        claim_id: { type: string, format: uuid }
        policy_id: { type: string, format: uuid }
        policyholder_id: { type: string, format: uuid }
        previous_status:
          type: string
          enum: [submitted, in_review, pending_docs, approved, rejected, paid]
        new_status:
          type: string
          enum: [submitted, in_review, pending_docs, approved, rejected, paid]
        approved_amount:
          type: number
          minimum: 0
        franchise_deduction: { type: number, minimum: 0 }
        rejection_reason: { type: string }
        additional_docs_request: { type: string }
        changed_by: { type: string, format: uuid }
        changed_at: { type: string, format: date-time }

    GatewayCallback:
      # зеркалит PaymentCallbackPayload из openAPI
      type: object
      additionalProperties: false
      required: [payment_id, policy_id, status, amount, paid_at]
      properties:
        payment_id: { type: string }
        policy_id: { type: string, format: uuid }
        status:
          type: string
          enum: [succeeded, failed, refunded]
        amount: { type: number, minimum: 0.01 }
        paid_at: { type: string, format: date-time }

    EmailPayload:
      type: object
      additionalProperties: false
      required: [notification_id, notification_type, recipient_email, subject, body_template, created_at]
      properties:
        notification_id: { type: string, format: uuid }
        notification_type:
          type: string
          enum:
            - policy_issued
            - fiscal_receipt
            - claim_submitted
            - claim_status_changed
            - expiring_reminder
            - password_reset
            - application_rejected
        recipient_email: { type: string, format: email }
        subject: { type: string }
        body_template: { type: string }
        template_params:
          type: object
        attachments:
          type: array
          items:
            type: object
            properties:
              file_name: { type: string }
              content_type: { type: string }
              uri: { type: string, format: uri }
        created_at: { type: string, format: date-time }

    SmsPayload:
      type: object
      required: [notification_id, notification_type, recipient_phone, message_text, created_at]
      properties:
        notification_id: { type: string, format: uuid }
        notification_type:
          type: string
          enum: [otp, policy_issued, expiring_reminder]
        recipient_phone:
          type: string
          pattern: '^\+7\d{10}$'
        message_text:
          type: string
          maxLength: 160
        created_at: { type: string, format: date-time }

    # общие

    InsuredPerson:
      type: object
      additionalProperties: false
      required: [full_name, birth_date, passport_number]
      properties:
        full_name: { type: string, maxLength: 200 }
        birth_date: { type: string, format: date }
        passport_number: { type: string, pattern: '^\d{4}\s?\d{6}$' }
        snils: { type: string, pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$' }
        phone: { type: string, pattern: '^\+7\d{10}$' }
        relationship: { type: string, enum: [self, spouse, child, parent] }

    ClaimDoc:
      type: object
      additionalProperties: false
      required: [document_id, file_name, content_type, size_bytes, uri]
      properties:
        document_id: { type: string, format: uuid }
        file_name: { type: string }
        content_type:
          type: string
          enum: [image/jpeg, image/png, application/pdf]
        size_bytes:
          type: integer
          maximum: 10485760
        uri: { type: string, format: uri }
