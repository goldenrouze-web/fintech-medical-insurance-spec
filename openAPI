openapi: 3.1.0
info:
  title: Сервис выпуска полисов ДМС
  description: |
    REST API для управления полисами добровольного медицинского страхования.
    Создание, поиск, обновление и удаление полисов.

    JSON-Schema для каждой сущности доступна через стандартный механизм OpenAPI:
    импортируйте этот файл в Swagger UI, Redoc или Stoplight для просмотра
    развёрнутых схем с примерами.
  version: 1.0.0
  contact:
    name: DMS API Support
    email: dms-api@example.com

security:
  - BearerAuth: []

paths:
  /dms/policies:
    post:
      summary: Создать заявку на полис
      description: |
        Создает заявку на выпуск полиса ДМС.
        Идемпотентность обеспечивается заголовком Idempotency-Key.
        Возвращает 404, если policyholder_id или coverage_program_id не найдены.
      tags: [dms-policies]
      operationId: createDmsPolicy
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DmsPolicyCreate'
            example:
              program_type: individual
              policyholder_id: "a1b2c3d4-0000-0000-0000-000000000001"
              coverage_program_id: "b2c3d4e5-0000-0000-0000-000000000001"
              insured_persons:
                - full_name: "Иванов Иван Иванович"
                  birth_date: "1990-05-15"
                  passport_number: "4510 123456"
                  phone: "+79161234567"
                  relationship: self
              valid_from: "2026-06-01"
              valid_to: "2027-06-01"
      responses:
        '201':
          $ref: '#/components/responses/PolicyCreated'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          description: Страхователь (policyholder_id) или программа (coverage_program_id) не найдены
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
              example:
                code: 404
                message: "Страхователь с id a1b2c3d4-... не найден"
                timestamp: "2026-05-12T10:00:00Z"
        '409':
          $ref: '#/components/responses/Conflict'
        '429':
          $ref: '#/components/responses/TooManyRequests'

    get:
      summary: Список полисов
      description: Возвращает пагинированный список полисов с фильтрацией и сортировкой.
      tags: [dms-policies]
      operationId: listDmsPolicies
      parameters:
        - $ref: '#/components/parameters/Limit'
        - $ref: '#/components/parameters/Offset'
        - $ref: '#/components/parameters/Sort'
        - $ref: '#/components/parameters/StatusFilter'
        - $ref: '#/components/parameters/ProgramTypeFilter'
        - $ref: '#/components/parameters/ValidFromFilter'
        - $ref: '#/components/parameters/ValidToFilter'
      responses:
        '200':
          $ref: '#/components/responses/PoliciesList'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /dms/policies/{policyId}:
    parameters:
      - $ref: '#/components/parameters/PolicyId'

    get:
      summary: Получить полис по ID
      tags: [dms-policies]
      operationId: getDmsPolicy
      responses:
        '200':
          $ref: '#/components/responses/PolicyDetails'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'

    put:
      summary: Обновить полис
      description: Полное обновление полиса. Частичное обновление не поддерживается.
      tags: [dms-policies]
      operationId: updateDmsPolicy
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DmsPolicyUpdate'
      responses:
        '200':
          $ref: '#/components/responses/PolicyUpdated'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          $ref: '#/components/responses/Conflict'
        '429':
          $ref: '#/components/responses/TooManyRequests'

    delete:
      summary: Удалить полис
      description: Удаляет полис. Допускается только для статусов draft и cancelled.
      tags: [dms-policies]
      operationId: deleteDmsPolicy
      responses:
        '204':
          description: Полис удален
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: Полис в статусе active/pending, удаление запрещено
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'

  /webhooks/payment-callback:
    post:
      summary: Callback от платежного шлюза
      description: |
        Вебхук, вызываемый платежным шлюзом после обработки платежа.
        Проверяет подпись в заголовке X-Signature.
        При успешной оплате переводит полис из pending в active.
      tags: [webhooks]
      operationId: paymentCallback
      security: []
      parameters:
        - name: X-Signature
          in: header
          required: true
          schema:
            type: string
          description: HMAC-SHA256 подпись тела запроса для проверки подлинности
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PaymentCallbackPayload'
            example:
              payment_id: "pay_abc123"
              policy_id: "a1b2c3d4-0000-0000-0000-000000000001"
              status: succeeded
              amount: 45000.00
              paid_at: "2026-05-12T14:30:00Z"
      responses:
        '200':
          description: Callback принят
        '400':
          description: Невалидная подпись или тело запроса
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'

components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: JWT-токен, полученный при аутентификации

  parameters:
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      schema:
        type: string
        format: uuid
      description: UUID для защиты от дублирования запроса

    PolicyId:
      name: policyId
      in: path
      required: true
      schema:
        type: string
        format: uuid
      description: UUID полиса

    Limit:
      name: limit
      in: query
      description: Количество записей на странице
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 20

    Offset:
      name: offset
      in: query
      description: Смещение от начала выборки
      schema:
        type: integer
        minimum: 0
        default: 0

    Sort:
      name: sort
      in: query
      description: "Поле сортировки. Префикс - означает убывание, например: -created_at"
      schema:
        type: string
        enum: [created_at, -created_at, valid_from, -valid_from, premium_amount, -premium_amount]
        default: -created_at

    StatusFilter:
      name: status
      in: query
      description: Фильтр по статусу полиса
      schema:
        type: string
        enum: [draft, pending, active, expired, cancelled]

    ProgramTypeFilter:
      name: program_type
      in: query
      description: Фильтр по типу программы
      schema:
        type: string
        enum: [individual, family, corporate]

    ValidFromFilter:
      name: valid_from
      in: query
      description: "Фильтр: дата начала действия не раньше указанной"
      schema:
        type: string
        format: date

    ValidToFilter:
      name: valid_to
      in: query
      description: "Фильтр: дата окончания действия не позже указанной"
      schema:
        type: string
        format: date

  schemas:
    DmsPolicy:
      type: object
      additionalProperties: false
      required: [policy_id, status, program_type, policyholder_id, insured_persons, coverage_program_id, valid_from, valid_to, premium_amount]
      properties:
        policy_id:
          type: string
          format: uuid
          readOnly: true
          description: UUID полиса, назначается сервером
        status:
          type: string
          enum: [draft, pending, active, expired, cancelled]
          description: "Текущий статус полиса. draft -- черновик, pending -- ожидает оплаты, active -- действует, expired -- истек, cancelled -- отменен"
        program_type:
          type: string
          enum: [individual, family, corporate]
          description: "Тип программы: individual -- физлицо, family -- семейный, corporate -- корпоративный"
        policyholder_id:
          type: string
          format: uuid
          description: UUID страхователя (того, кто платит)
        coverage_program_id:
          type: string
          format: uuid
          description: UUID программы покрытия из справочника (определяет набор услуг и лимиты)
        insured_persons:
          type: array
          minItems: 1
          items:
            $ref: '#/components/schemas/InsuredPerson'
          description: Список застрахованных лиц (минимум одно)
        valid_from:
          type: string
          format: date
          description: Дата начала действия полиса (включительно)
        valid_to:
          type: string
          format: date
          description: Дата окончания действия полиса (включительно)
        premium_amount:
          type: number
          format: double
          minimum: 0
          description: Сумма страховой премии в рублях
        created_at:
          type: string
          format: date-time
          readOnly: true
          description: Дата и время создания записи
        updated_at:
          type: string
          format: date-time
          readOnly: true
          description: Дата и время последнего обновления

    DmsPolicyCreate:
      type: object
      additionalProperties: false
      required: [program_type, policyholder_id, insured_persons, coverage_program_id, valid_from, valid_to]
      description: Тело запроса для создания полиса. Статус назначается сервером (draft).
      properties:
        program_type:
          type: string
          enum: [individual, family, corporate]
          description: Тип программы страхования
        policyholder_id:
          type: string
          format: uuid
          description: UUID страхователя
        coverage_program_id:
          type: string
          format: uuid
          description: UUID программы покрытия из справочника
        insured_persons:
          type: array
          minItems: 1
          items:
            $ref: '#/components/schemas/InsuredPerson'
          description: Застрахованные лица
        valid_from:
          type: string
          format: date
          description: Желаемая дата начала действия
        valid_to:
          type: string
          format: date
          description: Желаемая дата окончания действия

    DmsPolicyUpdate:
      type: object
      additionalProperties: false
      required: [program_type, policyholder_id, insured_persons, coverage_program_id, valid_from, valid_to]
      description: Тело запроса для обновления полиса. Полная замена, все поля обязательны.
      properties:
        status:
          type: string
          enum: [draft, pending, active, expired, cancelled]
          description: Новый статус полиса (переходы валидируются сервером)
        program_type:
          type: string
          enum: [individual, family, corporate]
          description: Тип программы
        policyholder_id:
          type: string
          format: uuid
          description: UUID страхователя
        coverage_program_id:
          type: string
          format: uuid
          description: UUID программы покрытия
        insured_persons:
          type: array
          minItems: 1
          items:
            $ref: '#/components/schemas/InsuredPerson'
          description: Застрахованные лица
        valid_from:
          type: string
          format: date
          description: Дата начала действия
        valid_to:
          type: string
          format: date
          description: Дата окончания действия

    InsuredPerson:
      type: object
      additionalProperties: false
      required: [full_name, birth_date, passport_number]
      description: Данные застрахованного лица
      properties:
        full_name:
          type: string
          maxLength: 200
          description: ФИО полностью
          example: "Иванов Иван Иванович"
        birth_date:
          type: string
          format: date
          description: Дата рождения
          example: "1990-05-15"
        passport_number:
          type: string
          pattern: '^\d{4}\s?\d{6}$'
          description: "Серия и номер паспорта РФ (формат: 4510 123456)"
          example: "4510 123456"
        snils:
          type: string
          pattern: '^\d{3}-\d{3}-\d{3}\s?\d{2}$'
          description: "СНИЛС (формат: 123-456-789 00)"
          example: "123-456-789 00"
        phone:
          type: string
          pattern: '^\+7\d{10}$'
          description: "Номер телефона (формат: +79161234567)"
          example: "+79161234567"
        relationship:
          type: string
          enum: [self, spouse, child, parent]
          description: "Отношение к страхователю: self -- сам, spouse -- супруг(а), child -- ребенок, parent -- родитель"
          example: "self"

    PaymentCallbackPayload:
      type: object
      additionalProperties: false
      required: [payment_id, policy_id, status, amount, paid_at]
      description: Тело callback-запроса от платежного шлюза
      properties:
        payment_id:
          type: string
          description: Идентификатор платежа в системе шлюза
        policy_id:
          type: string
          format: uuid
          description: UUID полиса, за который произведена оплата
        status:
          type: string
          enum: [succeeded, failed, refunded]
          description: "Результат платежа: succeeded -- успешно, failed -- отклонен, refunded -- возврат"
        amount:
          type: number
          format: double
          minimum: 0
          description: Сумма платежа в рублях
        paid_at:
          type: string
          format: date-time
          description: Время проведения платежа

    PoliciesListResponse:
      type: object
      additionalProperties: false
      description: Ответ со списком полисов и метаданными пагинации
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/DmsPolicy'
          description: Массив полисов
        total:
          type: integer
          description: Общее количество записей по фильтру
        limit:
          type: integer
          description: Размер страницы
        offset:
          type: integer
          description: Текущее смещение

    PolicyResponse:
      type: object
      additionalProperties: false
      description: Ответ с одним полисом
      properties:
        policy:
          $ref: '#/components/schemas/DmsPolicy'

    ApiError:
      type: object
      additionalProperties: false
      required: [code, message, timestamp]
      description: Стандартный формат ошибки API
      properties:
        code:
          type: integer
          description: HTTP-код ошибки
          example: 400
        message:
          type: string
          description: Человекочитаемое описание ошибки
          example: "Поле valid_from обязательно"
        timestamp:
          type: string
          format: date-time
          description: Время возникновения ошибки
          example: "2026-05-12T10:00:00Z"
        details:
          type: array
          items:
            type: string
          description: Детали валидации (если есть)
          example: ["valid_from: обязательное поле", "insured_persons: минимум 1 элемент"]

  responses:
    PolicyCreated:
      description: Полис создан
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/PolicyResponse'

    PolicyDetails:
      description: Данные полиса
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/PolicyResponse'

    PolicyUpdated:
      description: Полис обновлен
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/PolicyResponse'

    PoliciesList:
      description: Список полисов
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/PoliciesListResponse'

    BadRequest:
      description: Невалидное тело запроса или параметры
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ApiError'

    Unauthorized:
      description: Отсутствует или невалидный JWT-токен
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ApiError'

    Forbidden:
      description: Недостаточно прав для операции
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ApiError'

    NotFound:
      description: Ресурс не найден
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ApiError'

    Conflict:
      description: Конфликт (дубликат по Idempotency-Key или невалидный переход статуса)
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ApiError'

    TooManyRequests:
      description: Превышен лимит запросов
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ApiError'
      headers:
        Retry-After:
          schema:
            type: integer
          description: Через сколько секунд можно повторить запрос
